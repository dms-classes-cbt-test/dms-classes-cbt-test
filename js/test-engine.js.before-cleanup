// ==========================================
// LOAD TEST
// ==========================================

async function loadTest() {

    try {

        questions =
        await loadQuestionsFirebase();

    }

    catch (error) {

        console.log(error);

        questions = [];

    }

    // Local Backup

    if (questions.length === 0) {

        questions =
        JSON.parse(
            localStorage.getItem("questions")
        ) || [];

    }

    if (questions.length === 0) {

        alert("No Questions Available");

        window.location.href =
        "dashboard.html";

        return;

    }

    // Random Questions

    questions.sort(
        () => Math.random() - 0.5
    );

    // Random Options

    questions.forEach(function (q) {

        if (Array.isArray(q.options)) {

            q.options.sort(
                () => Math.random() - 0.5
            );

        }

    });

    // Arrays

    answers =
    new Array(questions.length).fill(null);

    reviewQuestions =
    new Array(questions.length).fill(false);

    // Load First Question

    showQuestion();

    createPalette();

    updateProgress();

    startTimer(10);

}
