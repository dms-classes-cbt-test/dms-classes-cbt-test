// ==========================================
// SHOW QUESTION
// ==========================================

function showQuestion() {

    if (questions.length === 0) return;

    const q = questions[currentQuestion];

    questionNo.innerHTML =
        "Question " +
        (currentQuestion + 1) +
        " / " +
        questions.length;

    questionText.innerHTML =
        q.question;

    option1.innerHTML = q.options[0];
    option2.innerHTML = q.options[1];
    option3.innerHTML = q.options[2];
    option4.innerHTML = q.options[3];

    const radios =
    document.querySelectorAll(
        "input[name='answer']"
    );

    // Set Radio Values

    radios[0].value = q.options[0];
    radios[1].value = q.options[1];
    radios[2].value = q.options[2];
    radios[3].value = q.options[3];

    // Remove Old Selection

    radios.forEach(function(radio){

        radio.checked = false;

    });

    // Restore Saved Answer

    if(answers[currentQuestion]){

        radios.forEach(function(radio){

            if(
                radio.value ===
                answers[currentQuestion]
            ){

                radio.checked = true;

            }

        });

    }

    createPalette();

    updateProgress();

}

// ==========================================
// SAVE ANSWER
// ==========================================

function saveAnswer(){

    const selected =
    document.querySelector(
        "input[name='answer']:checked"
    );

    if(selected){

        answers[currentQuestion] =
        selected.value;

    }

}

// ==========================================
// NEXT QUESTION
// ==========================================

function nextQuestion(){

    saveAnswer();

    if(
        currentQuestion <
        questions.length - 1
    ){

        currentQuestion++;

        showQuestion();

    }

}

// ==========================================
// PREVIOUS QUESTION
// ==========================================

function previousQuestion(){

    saveAnswer();

    if(currentQuestion > 0){

        currentQuestion--;

        showQuestion();

    }

}

